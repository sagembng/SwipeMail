# Copy this file to .env.local and fill in the values. Never commit .env.local.
# How to get the Google keys: docs/google-setup.md

# A long random string that encrypts the login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# From Google Cloud Console > APIs & Services > Credentials > your OAuth client
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# The email address shown as the contact on the Privacy Policy and Terms pages.
# Set it in Vercel too, then redeploy, because it is added when the site is built.
CONTACT_EMAIL=
